{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "content/*.json", "use": "@vercel/static" },
    { "src": "public/*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/content/(.*)", "dest": "/content/$1" },
    { "src": "/(.*\\.(?:css|js|json|svg|png|jpg|jpeg|webp|ico))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
